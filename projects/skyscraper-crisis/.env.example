# Load manually with: source .env
# SC_PROJECT_DIR is only necessary for the ComfyUI plugin.
export SC_PROJECT_DIR="/absolute/path/to/Explainer-Video-workflow/projects/skyscraper-crisis"
export SC_COMFY_DIR="/absolute/path/to/ComfyUI"
export SC_COMFY_URL="http://127.0.0.1:8190"
export SC_COMFY_PORT="8190"
# export SC_COMFY_INPUT="/absolute/path/to/ComfyUI/input"
# export SC_COMFY_OUTPUT="/absolute/path/to/ComfyUI/output"
# export SC_COMFY_PYTHON="/absolute/path/to/ComfyUI/.venv/bin/python"
# export SC_FFMPEG="/usr/bin/ffmpeg"
# export SC_FFPROBE="/usr/bin/ffprobe"
# Optional if automatic font discovery finds suitable installed fonts.
