[
  {
    "start": 0.55,
    "text": "接下来，时间开始发挥作用。",
    "end": 3.5460000000000003
  },
  {
    "start": 3.8660000000000005,
    "text": "从规划、审批、融资，",
    "end": 6.4535
  },
  {
    "start": 6.4535,
    "text": "到施工和交付，",
    "end": 8.1035
  },
  {
    "start": 8.1035,
    "text": "大型项目需要经过一连串环节。",
    "end": 11.0785
  },
  {
    "start": 11.0785,
    "text": "以双子塔为例，",
    "end": 12.6285
  },
  {
    "start": 12.6285,
    "text": "吉隆坡国家石油公司双子塔从1992年开始规划，",
    "end": 17.266000000000002
  },
  {
    "start": 17.266000000000002,
    "text": "到1999年正式开幕，",
    "end": 19.4035
  },
  {
    "start": 19.4035,
    "text": "跨过了好几年。",
    "end": 21.358
  },
  {
    "start": 21.678,
    "text": "可金融市场不会等施工队。",
    "end": 24.89
  },
  {
    "start": 25.21,
    "text": "一张订单可以取消，",
    "end": 26.8725
  },
  {
    "start": 26.8725,
    "text": "一笔贷款可以到期，",
    "end": 28.5475
  },
  {
    "start": 28.5475,
    "text": "一家公司可以停止扩张。",
    "end": 30.86
  },
  {
    "start": 30.86,
    "text": "建到一半的核心筒，",
    "end": 32.6225
  },
  {
    "start": 32.6225,
    "text": "却无法跟着市场消息立即变回现金。",
    "end": 36.414
  },
  {
    "start": 36.734,
    "text": "假设开工那年，",
    "end": 38.1715
  },
  {
    "start": 38.1715,
    "text": "企业还在增加员工，",
    "end": 39.7215
  },
  {
    "start": 39.7215,
    "text": "写字楼租金也在上涨。",
    "end": 41.8465
  },
  {
    "start": 41.8465,
    "text": "几年后，项目准备交付，",
    "end": 44.359
  },
  {
    "start": 44.359,
    "text": "企业却开始压缩成本，",
    "end": 46.4715
  },
  {
    "start": 46.4715,
    "text": "减少办公面积。",
    "end": 48.586
  },
  {
    "start": 48.906,
    "text": "开发商当年画在图纸上的需求，",
    "end": 51.418499999999995
  },
  {
    "start": 51.418499999999995,
    "text": "和今天真正来签租约的客户，",
    "end": 53.6185
  },
  {
    "start": 53.6185,
    "text": "就出现了差距。",
    "end": 55.43
  },
  {
    "start": 55.75,
    "text": "这也解释了为什么，",
    "end": 57.1875
  },
  {
    "start": 57.1875,
    "text": "高楼竣工和经济下行，",
    "end": 59.175
  },
  {
    "start": 59.175,
    "text": "有时会出现在相近的时间：",
    "end": 61.1875
  },
  {
    "start": 61.1875,
    "text": "施工计划还在兑现过去的决定，",
    "end": 63.574999999999996
  },
  {
    "start": 63.574999999999996,
    "text": "市场已经在交易新的现实。",
    "end": 66.402
  },
  {
    "start": 66.722,
    "text": "这个时间差能解释一些现象，",
    "end": 69.2845
  },
  {
    "start": 69.2845,
    "text": "却不能证明每座高楼都遵循同一条规律。",
    "end": 73.534
  }
]
