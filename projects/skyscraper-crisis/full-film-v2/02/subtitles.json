[
  {
    "start": 0.55,
    "text": "先纠正一个经常被讲反的细节。",
    "end": 4.026
  },
  {
    "start": 4.345999999999999,
    "text": "美国股市的那场著名崩盘，",
    "end": 6.670999999999999
  },
  {
    "start": 6.670999999999999,
    "text": "发生在1929年10月。",
    "end": 9.171
  },
  {
    "start": 9.171,
    "text": "帝国大厦正式开工，",
    "end": 11.0085
  },
  {
    "start": 11.0085,
    "text": "却是在1930年3月。",
    "end": 13.725999999999999
  },
  {
    "start": 14.046,
    "text": "也就是说，这个最常被拿来证明“高楼预告危机”的例子，",
    "end": 18.496
  },
  {
    "start": 18.496,
    "text": "甚至是在股灾之后才开始施工。",
    "end": 21.794
  },
  {
    "start": 22.114,
    "text": "它提醒我们：宣布要建、正式开工、主体封顶和开门营业，",
    "end": 27.738999999999997
  },
  {
    "start": 27.738999999999997,
    "text": "是四个不同的时刻。",
    "end": 29.91
  },
  {
    "start": 30.23,
    "text": "如果需要的时候用开工日期，",
    "end": 32.7675
  },
  {
    "start": 32.7675,
    "text": "不方便的时候改用竣工日期，",
    "end": 35.2425
  },
  {
    "start": 35.2425,
    "text": "再把危机发生的前后几年都算进去，",
    "end": 37.9675
  },
  {
    "start": 37.9675,
    "text": "很多故事都会显得格外准确。",
    "end": 41.001999999999995
  },
  {
    "start": 41.321999999999996,
    "text": "所以，先别急着把高楼当成预言。",
    "end": 45.422
  },
  {
    "start": 45.422,
    "text": "我们真正要解释的，",
    "end": 46.971999999999994
  },
  {
    "start": 46.971999999999994,
    "text": "是一个项目为什么会被启动，",
    "end": 49.384499999999996
  },
  {
    "start": 49.384499999999996,
    "text": "又为什么会在交付时遇到完全不同的市场。",
    "end": 53.102
  }
]
