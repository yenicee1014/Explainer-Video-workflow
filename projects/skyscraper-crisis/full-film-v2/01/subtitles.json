[
  {
    "start": 0.55,
    "text": "1931年5月1日，",
    "end": 2.4250000000000003
  },
  {
    "start": 2.4250000000000003,
    "text": "纽约帝国大厦正式开幕。",
    "end": 5.106
  },
  {
    "start": 5.425999999999999,
    "text": "一座超过一百层的建筑，",
    "end": 7.4384999999999994
  },
  {
    "start": 7.4384999999999994,
    "text": "把人类能够向上建造的高度，",
    "end": 9.576
  },
  {
    "start": 9.576,
    "text": "又推进了一步。",
    "end": 11.446
  },
  {
    "start": 11.766,
    "text": "但在街道另一头，",
    "end": 13.2035
  },
  {
    "start": 13.2035,
    "text": "经济已经是另一番景象。",
    "end": 15.566
  },
  {
    "start": 15.566,
    "text": "美国正陷在大萧条之中：",
    "end": 18.066000000000003
  },
  {
    "start": 18.066000000000003,
    "text": "企业收缩，工人失业，",
    "end": 20.391
  },
  {
    "start": 20.391,
    "text": "银行体系不断承受压力。",
    "end": 23.21
  },
  {
    "start": 23.53,
    "text": "一边是刷新纪录的高楼，",
    "end": 25.5675
  },
  {
    "start": 25.5675,
    "text": "一边是不断下沉的经济。",
    "end": 27.6425
  },
  {
    "start": 27.6425,
    "text": "把它们放在同一张照片里，",
    "end": 30.13
  },
  {
    "start": 30.13,
    "text": "很容易产生一个疑问：",
    "end": 32.2175
  },
  {
    "start": 32.2175,
    "text": "为什么人类最宏大的建筑，",
    "end": 34.417500000000004
  },
  {
    "start": 34.417500000000004,
    "text": "有时偏偏出现在经济最难看的年份？",
    "end": 37.782
  },
  {
    "start": 38.102,
    "text": "类似的画面，也出现在后来的迪拜。",
    "end": 41.1645
  },
  {
    "start": 41.1645,
    "text": "2009年11月，",
    "end": 42.876999999999995
  },
  {
    "start": 42.876999999999995,
    "text": "迪拜世界及其子公司的债务延期偿付风波震动市场。",
    "end": 48.0145
  },
  {
    "start": 48.0145,
    "text": "2010年1月4日，",
    "end": 49.852
  },
  {
    "start": 49.852,
    "text": "哈利法塔正式开幕。",
    "end": 52.257999999999996
  },
  {
    "start": 52.577999999999996,
    "text": "于是，这类故事被串成了一个颇有吸引力的说法：",
    "end": 56.665499999999994
  },
  {
    "start": 56.665499999999994,
    "text": "摩天大楼指数。",
    "end": 58.50299999999999
  },
  {
    "start": 58.50299999999999,
    "text": "仿佛只要世界最高楼准备亮灯，",
    "end": 61.053
  },
  {
    "start": 61.053,
    "text": "经济危机就已经在门外排队。",
    "end": 64.07
  },
  {
    "start": 64.38999999999999,
    "text": "但一栋楼，真的有这样的预言能力吗？",
    "end": 67.88999999999999
  },
  {
    "start": 68.20999999999998,
    "text": "要回答这个问题，",
    "end": 69.75999999999999
  },
  {
    "start": 69.75999999999999,
    "text": "我们得把目光从楼顶，",
    "end": 71.53499999999998
  },
  {
    "start": 71.53499999999998,
    "text": "移到银行的合同和开发商的账本上。",
    "end": 75.06999999999998
  }
]
