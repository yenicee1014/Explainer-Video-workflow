          "start": 53.132563000000005,
          "anchor": 53.132563000000005
        },
        {
          "id": "misuse",
          "text": "接着管使用方式。加阴影，套上圆圈，随意旋转，都被列成了错误示范。",
          "rate": 240,
          "duration": 5.884354,
          "onset": 0,
          "trimStart": 0,
