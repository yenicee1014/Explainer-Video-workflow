          "sourceDuration": 5.884354,
          "key": "manual-misuse",
          "path": "assets/rebuild-voice/manual-misuse.wav",
          "localStart": 16.232792,
          "start": 59.232792,
          "anchor": 59.232792
        },
        {
          "id": "red",
          "text": "颜色也有规矩。红色字标，配白色或浅灰色的底面。",
          "rate": 240,
          "duration": 4.164729,
          "onset": 0,
          "trimStart": 0,
          "trimEnd": 4.164717,
          "sourceDuration": 4.164717,
          "key": "manual-red",
          "path": "assets/rebuild-voice/manual-red.wav",
          "localStart": 22.497146,
          "start": 65.497146,
          "anchor": 65.497146
        },
        {
          "id": "reject",
          "text": "让高饱和颜色到处争抢注意，反而破坏了识别。",
